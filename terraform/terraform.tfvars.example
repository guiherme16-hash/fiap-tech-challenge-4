aws_region   = "us-east-1"
project_name = "togglemaster"
environment  = "prod"

# Networking
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.0.0/20", "10.0.16.0/20"]
private_subnet_cidrs = ["10.0.128.0/20", "10.0.144.0/20"]
single_nat_gateway   = true

# EKS
kubernetes_version  = "1.31"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3

# RDS
rds_engine_version    = "16"
rds_instance_class    = "db.t3.micro"
rds_allocated_storage = 20

# ElastiCache
redis_node_type      = "cache.t3.micro"
redis_engine_version = "7.1"

# DynamoDB / SQS
dynamodb_table_name = "ToggleMasterAnalytics"
sqs_queue_name      = "analytics-service-sqs"

# GitHub Actions (OIDC -> ECR)
github_owner                = "FIAP-TCs"
github_repo                 = "fiap-tech-challenge-3"
create_github_oidc_provider = true
